  "patterns": [
    { "match": "^Turn (\\d+) · Step (\\d+)$", "replace": "第 $1 轮 · 第 $2 步" },
    { "match": "^Turn (\\d+)$", "replace": "第 $1 轮" },
    { "match": "^Step (\\d+)$", "replace": "第 $1 步" },
    { "match": "^Request #(\\d+)$", "replace": "请求 #$1" },
    { "match": "^The file (.+) has been updated successfully\\.$", "replace": "文件 $1 已更新" }
  ]
